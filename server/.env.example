PORT=5000
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
LLM_MODEL=qwen3:4b
# Answer model for /api/chat (falls back to LLM_MODEL when unset).
#ANSWER_MODEL=qwen3:4b
# Max tokens per answer (raised default avoids cut-off answers).
#LLM_NUM_PREDICT=2048
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=knowledge_base
# Retrieval mode for the Change-1 entry point (server/src/retrieval/index.js).
# dense (default, current behaviour), hybrid, hybrid_rerank, hybrid_rerank_meta, or adaptive.
# Measured later; do not assume any hybrid/adaptive mode is better.
RETRIEVAL_MODE=dense
# Rerank backend for hybrid_rerank (server/src/retrieval/rerank.js):
# lexical (default, always offline) | cross-encoder (needs optional @xenova/transformers) | auto.
RERANK_BACKEND=lexical
# Cross-encoder model used when RERANK_BACKEND=cross-encoder/auto (downloaded once, then offline).
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# Evidence assembly (Change 4, adaptive chat path only):
#EVIDENCE_DECOMP_TIMEOUT_MS=15000
#EVIDENCE_COVERAGE_THRESHOLD=0.35
#EVIDENCE_MAX_RETRIES=2
#EVIDENCE_COVERAGE_METHOD=lexical
# Retrieval debug endpoint GET /api/retrieval/debug/:queryId (dev only, 403 unless enabled):
#EVAL_DEBUG_ENABLED=1
# Optional Ollama judge timeout for faithfulness approximation:
#EVAL_JUDGE_TIMEOUT_MS=20000
OLLAMA_API_KEY=your_ollama_api_key_here
